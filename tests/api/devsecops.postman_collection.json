        {
          "name": "11 POST /api/users - create user with unique email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run (timestamp-based) so the suite can be re-run without manual cleanup.",
                  "// Stored as collection variables so the login test (12) can target the same user.",
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('userName', 'apitester' + ts);",
                  "pm.collectionVariables.set('userEmail', 'apitester' + ts + '@example.com');",
                  "pm.collectionVariables.set('userPassword', 'C0rrectPassw0rd!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Body message is \"User created\"', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.eql('User created');",
                  "});",
                  "",
                  "pm.test('Body has exists = false', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.exists).to.eql(false);",
                  "});"
                ]
              }
            }
