{
  "info": {
    "name": "DevSecOps Task API",
    "description": "API tests for the Spring Boot Task backend (Tasks CRUD + Users/Auth). Designed to run top-to-bottom with Newman against a freshly started backend (seed data present), no manual steps required. Override baseUrl with --env-var baseUrl=<url> if needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tasks",
      "item": [
        {
          "name": "01 GET /api/tasks - list contains seed task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response body is an array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('List contains seed task \"Plan the next sprint\" with priority HIGH', function () {",
                  "    const json = pm.response.json();",
                  "    const seed = json.find(function (t) { return t.title === 'Plan the next sprint'; });",
                  "    pm.expect(seed, 'seed task \"Plan the next sprint\" not found in list').to.exist;",
                  "    pm.expect(seed.priority).to.eql('HIGH');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 POST /api/tasks - create valid task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Body has numeric id', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.collectionVariables.set('taskId', String(json.id));",
                  "    pm.collectionVariables.set('taskTitle', json.title);",
                  "});",
                  "",
                  "pm.test('New task has completed = false', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.completed).to.eql(false);",
                  "});",
                  "",
                  "pm.test('Body echoes title, priority and dueDate', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.title).to.include('API test task');",
                  "    pm.expect(json.priority).to.eql('MEDIUM');",
                  "    pm.expect(json.dueDate).to.eql('2026-07-01');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"API test task {{$timestamp}}\",\n    \"priority\": \"MEDIUM\",\n    \"dueDate\": \"2026-07-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
